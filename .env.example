# Copy to .env and adjust. Everything has a working default for local dev.

# Database (SQLite for dev; swap for a Postgres URL in production)
DATABASE_URL=sqlite:///./attendance.db

# PIN policy
PIN_LENGTH=4

# Check-out safety guard (minutes) — a check-out is rejected if the check-in
# was fewer than this many minutes ago.
TIME_GUARD_MINUTES=30

# App
APP_NAME=SquashBusters Attendance

# Notifications
# console = log emails only (safe default); smtp = actually send.
EMAIL_BACKEND=console
EMAIL_FROM=SquashBusters Attendance <no-reply@squashbusters.org>
# Only needed when EMAIL_BACKEND=smtp. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
